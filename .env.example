# === Application ===
APP_NAME=HealthcareRouteOptimizer
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# === Security ===
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-in-production-use-a-long-random-secret-at-least-64-chars
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
FIELD_ENCRYPTION_KEY=change-me-32-bytes-base64-urlsafe

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# === Database ===
POSTGRES_USER=icy
POSTGRES_PASSWORD=icy_dev_password_change_me
POSTGRES_DB=icy
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://icy:icy_dev_password_change_me@localhost:5432/icy

# === Redis / Celery ===
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# === Routing provider ===
# Options: haversine, osrm, openrouteservice
ROUTING_PROVIDER=haversine
OSRM_BASE_URL=http://localhost:5000
OPENROUTESERVICE_API_KEY=

# === CORS ===
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# === Frontend (Vite) ===
VITE_API_BASE_URL=http://localhost:8000
VITE_MAP_TILES_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
