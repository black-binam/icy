# === Application ===
APP_NAME=HealthcareRouteOptimizer
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# === Security ===
# IMPORTANT: the application refuses to start if SECRET_KEY or
# FIELD_ENCRYPTION_KEY contain the substring "change-me". You MUST
# generate real values before any deployment.
#
# Generate SECRET_KEY (>= 64 chars):
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=REPLACE_ME_with_64+_random_chars__see_comment_above_to_generate_one
#
# Generate FIELD_ENCRYPTION_KEY (Fernet, 32 raw bytes urlsafe-base64):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=REPLACE_ME_with_a_real_Fernet_key_44_chars_urlsafe_base64=

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Trusted reverse-proxy CIDRs allowed to set X-Forwarded-For. Leave empty
# in dev. In prod set this to your ingress / load-balancer subnet only.
TRUSTED_PROXY_CIDRS=

# === Database ===
POSTGRES_USER=icy
POSTGRES_PASSWORD=icy_dev_password_change_me
POSTGRES_DB=icy
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://icy:icy_dev_password_change_me@localhost:5432/icy

# === Redis / Celery ===
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# === Routing provider ===
# Options: haversine, osrm, openrouteservice
ROUTING_PROVIDER=haversine
OSRM_BASE_URL=http://localhost:5000
OPENROUTESERVICE_API_KEY=

# === CORS ===
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# === Frontend (Vite) ===
VITE_API_BASE_URL=http://localhost:8000
VITE_MAP_TILES_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
